# Copy this file to `.env` and adjust values before running the services.
MAI_ADMIN_USERNAME=change-me
MAI_ADMIN_PASSWORD=change-me
MAI_DB_PATH=var/data/mai.db

# OCR para PDFs escaneados (requer tesseract instalado no sistema/container)
# MAI_PDF_OCR_ENABLED=true
# MAI_PDF_OCR_LANG=eng+por
# MAI_PDF_OCR_MAX_PAGES=3
# MAI_PDF_OCR_DPI=200
# MAI_PDF_OCR_TIMEOUT_SECONDS=10
# MAI_PDF_OCR_TRIGGER_TEXT_CHARS=40
